# Copy to .env and adjust as needed.
DEBUG=true

# OCR (only needed for scanned PDFs)
# Windows example if tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
OCR_DPI=300
MIN_TEXT_CHARS=40

# News providers — paste your free-tier keys. The news layer tries them in
# finance-native order and uses the first that returns query-relevant articles;
# any left blank are skipped. (finnhub & alphavantage are ticker-only feeds.)
NEWS_MARKETAUX_KEY=
NEWS_FINNHUB_KEY=
NEWS_ALPHAVANTAGE_KEY=
NEWS_NEWSDATA_IO_KEY=
NEWS_NEWSAPI_AI_KEY=
NEWS_WORLDNEWSAPI_KEY=
NEWS_GNEWS_IO_KEY=
NEWS_NEWSAPI_ORG_KEY=
# NEWS_MAX_ARTICLES=10
