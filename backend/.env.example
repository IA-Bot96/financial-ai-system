# Copy to .env and adjust as needed.
DEBUG=true

# OCR (only needed for scanned PDFs)
# Windows example if tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
OCR_DPI=300
MIN_TEXT_CHARS=40

# News providers — paste your free-tier keys. The news layer tries them in
# finance-native order and uses the first that returns query-relevant articles;
# any left blank are skipped. (finnhub & alphavantage are ticker-only feeds.)
NEWS_MARKETAUX_KEY=
NEWS_FINNHUB_KEY=
NEWS_ALPHAVANTAGE_KEY=
NEWS_NEWSDATA_IO_KEY=
NEWS_NEWSAPI_AI_KEY=
NEWS_WORLDNEWSAPI_KEY=
NEWS_GNEWS_IO_KEY=
NEWS_NEWSAPI_ORG_KEY=
# NEWS_MAX_ARTICLES=10

# OpenAI (LLM narration / understanding assist; blank => deterministic path only)
OPENAI_API_KEY=

# --- Security / hardening ---------------------------------------------------
# Production (Heroku): set FORCE_HTTPS=true and pin CORS to your real frontend.
# FORCE_HTTPS=false
# CORS_ALLOW_ORIGINS=https://app.example.com
# FIE_MAX_QUERY_CHARS=256
# MAX_REQUEST_BYTES=2000000
# MAX_UPLOAD_BYTES=157286400         # 150 MB
# REQUEST_TIMEOUT_SECONDS=60
# MAX_EXTERNAL_CALLS_PER_REQUEST=12
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CAPACITY=3              # burst size
# RATE_LIMIT_REFILL_SECONDS=1        # sustained rate = 1 / this (1 req/sec)
# LLM_MAX_INPUT_CHARS=24000
# LLM_MAX_OUTPUT_TOKENS=800
# NEWS_DAILY_CALL_CAP_PER_PROVIDER=200   # 0 = unlimited
